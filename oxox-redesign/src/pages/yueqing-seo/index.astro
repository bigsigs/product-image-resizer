---
import "../../styles/reference.css";
import "../../styles/reference-pages.css";
import Wordmark from "../../components/Wordmark.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import seoCompanies from "../../data/seo-companies.js";
import {
  filterSeoCompanies,
  summarizeSeoCompanies,
} from "../../lib/seo-ranking-core.js";

const snapshotDate = "2026-08-29";
const palette = ["#ff5c35", "#f5d451", "#0b634b", "#5f94c9", "#c8789b", "#8588c7"];
const companies = seoCompanies.map((company, index) => ({
  ...company,
  accent: palette[index % palette.length],
  icon: `/company-icons/${company.domain}.png`,
  initials: company.brand.replace(/[^A-Z0-9]/g, "").slice(0, 2) || "YQ",
}));
const summary = summarizeSeoCompanies(companies);
const initialCompanies = filterSeoCompanies(companies, { sortBy: "traffic" }).slice(0, 20);
const leaders = filterSeoCompanies(companies, { sortBy: "traffic" }).slice(0, 3);
const formatNumber = (value: number | null) => {
  if (value === null) return "N/A";
  if (value >= 100000) return `${(value / 10000).toFixed(value % 10000 === 0 ? 0 : 1)}万`;
  if (value >= 10000) return `${(value / 10000).toFixed(1)}万`;
  return new Intl.NumberFormat("zh-CN").format(value);
};
const changeClass = (value: number | null) => value === null || value === 0
  ? "neutral"
  : value > 0 ? "positive" : "negative";
const changeText = (value: number | null) => {
  if (value === null) return "—";
  const arrow = value === 0 ? "→" : value > 0 ? "↗" : "↘";
  return `${arrow} ${value > 0 ? "+" : ""}${value.toFixed(value % 1 === 0 ? 0 : 2)}%`;
};
const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "乐清电气企业 SEO 榜单",
  url: "https://oxox.cn/yueqing-seo/",
  description: "基于 Semrush 第三方估算数据整理的乐清电气企业搜索表现榜单，不代表企业真实流量。",
  dateModified: snapshotDate,
  temporalCoverage: snapshotDate,
  measurementTechnique: "Semrush 第三方估算数据",
  variableMeasured: ["自然流量", "关键词", "反向链接", "AI 品牌曝光"],
  creator: { "@type": "Organization", name: "OXOX 乐清出口数据", url: "https://oxox.cn/" },
};
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="乐清电气企业 SEO 榜单，比较自然流量、关键词、反向链接与 AI 品牌曝光，支持企业搜索、指标筛选和相对排名。">
  <meta name="theme-color" content="#f2f0e8">
  <link rel="canonical" href="https://oxox.cn/yueqing-seo/">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title>乐清 SEO 榜单｜乐清企业搜索表现｜OXOX</title>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(datasetSchema).replace(/</g, "\\u003c")}></script>
  <style is:global>
    :root {
      --paper: #f2f0e8;
      --paper-light: #faf9f4;
      --ink: #18201d;
      --muted: #68716c;
      --green: #0b634b;
      --green-dark: #064636;
      --orange: #ff5c35;
      --yellow: #f5d451;
      --line: rgba(24, 32, 29, .16);
      --serif: "Iowan Old Style", "Baskerville", "Songti SC", "STSong", serif;
      --sans: "Avenir Next", "PingFang SC", "Hiragino Sans GB", sans-serif;
      --mono: "SFMono-Regular", "Cascadia Code", Consolas, monospace;
    }

    * { box-sizing: border-box; }
    html { min-width: 320px; scroll-behavior: smooth; background: var(--paper); }
    body {
      margin: 0;
      color: var(--ink);
      font-family: var(--sans);
      background:
        radial-gradient(circle at 88% 4%, rgba(245, 212, 81, .28), transparent 23rem),
        linear-gradient(90deg, transparent 49.8%, rgba(24, 32, 29, .035) 50%, transparent 50.2%),
        var(--paper);
      background-size: auto, 56px 100%, auto;
    }

    a { color: inherit; text-decoration: none; }
    button, input, select { color: inherit; font: inherit; }
    button { cursor: pointer; }
    svg { display: block; }
    [hidden] { display: none !important; }

    .noise {
      position: fixed;
      inset: 0;
      z-index: 100;
      opacity: .025;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E");
    }

    .shell {
      width: min(1440px, calc(100% - 48px));
      margin: 0 auto;
    }

    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 92px;
      border-bottom: 1px solid var(--line);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 14px;
    }

    .wordmark {
      --dot-travel: 10px;
      width: 126px;
      height: auto;
      overflow: visible;
    }

    .wordmark .logo-dot,
    .footer-mark .logo-dot {
      transform-box: fill-box;
      transform-origin: center;
      will-change: transform;
    }

    .brand:hover .dot-warm,
    .brand:focus-visible .dot-warm,
    .footer-mark:hover .dot-warm {
      animation: dotOrbitClockwise .9s cubic-bezier(.45, 0, .2, 1);
    }

    .brand:hover .dot-green,
    .brand:focus-visible .dot-green,
    .footer-mark:hover .dot-green {
      animation: dotOrbitCounter .9s .06s cubic-bezier(.45, 0, .2, 1);
    }

    .brand-label {
      padding-left: 14px;
      border-left: 1px solid var(--line);
      color: var(--muted);
      font-size: 12px;
      font-weight: 650;
      letter-spacing: .12em;
    }

    .header-nav {
      display: flex;
      align-items: center;
      gap: 30px;
      font-size: 13px;
      font-weight: 650;
    }

    .header-nav a {
      position: relative;
      padding: 9px 0;
    }

    .header-nav a::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 2px;
      left: 0;
      height: 2px;
      background: var(--orange);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform .2s ease;
    }

    .header-nav a:hover::after,
    .header-nav a:focus-visible::after,
    .header-nav a[aria-current="page"]::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(360px, .85fr);
      gap: clamp(48px, 7vw, 108px);
      align-items: center;
      min-height: 440px;
      padding: 44px 0 58px;
      border-bottom: 1px solid var(--line);
      overflow: clip;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 11px;
      margin: 0 0 27px;
      color: var(--green);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 27px;
      height: 7px;
      border-radius: 99px;
      background: var(--orange);
    }

    h1 {
      max-width: 850px;
      margin: 0;
      font: 650 clamp(58px, 6.7vw, 98px) / .91 var(--serif);
      letter-spacing: -.065em;
    }

    h1 .title-accent {
      position: relative;
      display: inline-block;
      color: var(--green);
      font-style: normal;
    }

    h1 .title-accent::after {
      content: "";
      position: absolute;
      right: -.14em;
      bottom: -.08em;
      left: .03em;
      height: .075em;
      border-radius: 99px;
      background: var(--yellow);
    }

    .hero-intro {
      max-width: 650px;
      margin: 31px 0 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.85;
    }

    .hero-intro strong { color: var(--ink); }

    .pulse-card {
      position: relative;
      padding: 28px 28px 0;
      color: white;
      background: var(--green-dark);
      box-shadow: 13px 13px 0 var(--yellow);
    }

    .pulse-card::before {
      content: "";
      position: absolute;
      top: -13px;
      right: 33px;
      width: 25px;
      height: 25px;
      border-radius: 50%;
      background: var(--orange);
      box-shadow: 0 0 0 9px var(--paper);
    }

    .pulse-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      padding-bottom: 20px;
      border-bottom: 1px solid rgba(255,255,255,.22);
    }

    .pulse-head span {
      color: rgba(255,255,255,.66);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .14em;
    }

    .pulse-head strong {
      font: 500 47px/.8 var(--serif);
      letter-spacing: -.06em;
    }

    .pulse-total {
      display: flex;
      flex-direction: column;
      align-items: end;
      gap: 8px;
    }

    .pulse-total small {
      color: rgba(255,255,255,.55);
      font-size: 8px;
      font-weight: 800;
      letter-spacing: .12em;
    }

    .leader-stairs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: end;
      min-height: 245px;
      margin-top: 22px;
    }

    .leader-step {
      display: flex;
      min-width: 0;
      height: var(--step-height);
      flex-direction: column;
      padding: 16px 14px 15px;
      color: var(--ink);
      background: var(--step-color);
      border-right: 1px solid var(--green-dark);
      transition: transform .22s ease;
    }

    .leader-step:last-child { border-right: 0; }
    .leader-step:hover { transform: translateY(-7px); }

    .leader-rank {
      display: flex;
      align-items: start;
      justify-content: space-between;
      gap: 8px;
    }

    .leader-rank strong {
      font: 500 clamp(30px, 3.5vw, 45px)/.8 var(--serif);
      letter-spacing: -.07em;
    }

    .leader-icon {
      width: 38px;
      height: 38px;
      flex: 0 0 auto;
      object-fit: contain;
      border: 1px solid rgba(24,32,29,.18);
      border-radius: 9px;
      background: white;
    }

    .leader-company {
      min-width: 0;
      margin-top: auto;
    }

    .leader-company b {
      display: -webkit-box;
      overflow: hidden;
      font-size: 10px;
      font-weight: 800;
      line-height: 1.35;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .leader-company small {
      display: block;
      overflow: hidden;
      margin-top: 5px;
      color: rgba(24,32,29,.58);
      font: 700 8px/1.2 var(--mono);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .leader-traffic {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 5px;
      margin-top: 12px;
      padding-top: 10px;
      border-top: 1px solid rgba(24,32,29,.24);
    }

    .leader-traffic span {
      font: 500 clamp(20px, 2.4vw, 29px)/1 var(--serif);
      letter-spacing: -.05em;
      white-space: nowrap;
    }

    .leader-traffic small {
      color: rgba(24,32,29,.58);
      font-size: 7px;
      font-weight: 800;
      letter-spacing: .08em;
    }

    .summary-strip {
      display: grid;
      grid-template-columns: 1.05fr repeat(5, 1fr);
      border-right: 1px solid var(--ink);
      border-bottom: 1px solid var(--ink);
      background: var(--paper-light);
    }

    .summary-strip > * {
      min-height: 133px;
      padding: 23px;
      border-left: 1px solid var(--ink);
      border-top: 1px solid var(--ink);
    }

    .summary-label {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: white;
      background: var(--ink);
    }

    .summary-label small,
    .summary-card span {
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .13em;
    }

    .summary-label strong {
      font: 500 28px/1 var(--serif);
    }

    .summary-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .summary-card span { color: var(--muted); }
    .summary-card strong {
      font: 500 clamp(27px, 3vw, 43px)/1 var(--serif);
      letter-spacing: -.055em;
    }

    .ranking-section { padding: 92px 0 100px; }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 35px;
      margin-bottom: 31px;
    }

    .section-kicker {
      margin: 0 0 13px;
      color: var(--orange);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .18em;
    }

    h2 {
      max-width: 840px;
      margin: 0;
      font: 500 clamp(40px, 5vw, 66px)/.95 var(--serif);
      letter-spacing: -.06em;
    }

    .result-count {
      margin: 0;
      color: var(--muted);
      font-size: 11px;
    }

    .result-count strong {
      color: var(--ink);
      font: 700 18px/1 var(--mono);
    }

    .toolbar {
      display: grid;
      grid-template-columns: minmax(250px, 1fr) auto minmax(230px, .45fr);
      gap: 13px;
      align-items: center;
      margin-bottom: 19px;
      padding: 13px;
      border: 1px solid var(--line);
      background: rgba(250, 249, 244, .78);
    }

    .search-control {
      display: flex;
      align-items: center;
      min-height: 48px;
      padding: 0 16px;
      border: 1px solid var(--ink);
      background: white;
    }

    .search-control span {
      margin-right: 10px;
      color: var(--green);
      font: 500 24px/1 var(--serif);
    }

    .search-control input {
      width: 100%;
      min-width: 0;
      border: 0;
      outline: 0;
      background: transparent;
      font-size: 14px;
    }

    .filter-control {
      display: flex;
      gap: 4px;
      align-items: center;
    }

    .filter-control button {
      min-height: 40px;
      padding: 0 12px;
      border: 0;
      background: transparent;
      color: var(--muted);
      font-size: 10px;
      font-weight: 750;
    }

    .filter-control button:hover,
    .filter-control button[aria-pressed="true"] {
      color: var(--ink);
      background: var(--yellow);
    }

    .sort-control {
      position: relative;
      min-width: 0;
    }

    .sort-control select {
      width: 100%;
      min-height: 42px;
      padding: 0 38px 0 13px;
      border: 1px solid var(--line);
      border-radius: 0;
      outline: 0;
      appearance: none;
      background: var(--paper-light);
      font-size: 11px;
      font-weight: 700;
    }

    .sort-control::after {
      content: "↓";
      position: absolute;
      top: 50%;
      right: 14px;
      color: var(--green);
      pointer-events: none;
      transform: translateY(-50%);
    }

    .rank-table { border-top: 1px solid var(--ink); }
    .rank-head,
    .company-row {
      display: grid;
      grid-template-columns: minmax(300px, 1.7fr) repeat(5, minmax(115px, .72fr));
    }

    .rank-head {
      min-height: 45px;
      align-items: center;
      color: var(--muted);
      border-bottom: 1px solid var(--line);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .1em;
    }

    .rank-head > * { padding: 0 17px; }

    .company-row {
      position: relative;
      min-height: 99px;
      border-bottom: 1px solid var(--line);
      background: rgba(250,249,244,.72);
      transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
    }

    .company-row::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 4px;
      background: var(--accent);
      transform: scaleY(0);
      transform-origin: bottom;
      transition: transform .2s ease;
    }

    .company-row:hover {
      z-index: 1;
      background: white;
      box-shadow: -5px 0 0 var(--yellow), 0 14px 32px rgba(24,32,29,.08);
      transform: translateX(5px);
    }

    .company-row:hover::before { transform: scaleY(1); }

    .company-cell {
      display: grid;
      grid-template-columns: 33px 44px minmax(0, 1fr);
      gap: 13px;
      align-items: center;
      padding: 14px 18px 14px 8px;
    }

    .rank-number {
      color: var(--muted);
      font: 700 10px/1 var(--mono);
    }

    .company-avatar {
      position: relative;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--ink);
      border-radius: 50%;
      overflow: hidden;
      background: white;
      font-size: 12px;
      font-weight: 900;
    }

    .company-avatar > span {
      color: var(--ink);
      opacity: .42;
    }

    .company-avatar img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      padding: 6px;
      object-fit: contain;
      background: white;
    }

    .company-name { min-width: 0; }
    .company-name strong {
      display: block;
      overflow: hidden;
      margin-bottom: 7px;
      font: 700 17px/1 var(--serif);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .company-name a {
      display: block;
      overflow: hidden;
      color: var(--muted);
      font: 10px/1.2 var(--mono);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .company-name a:hover { color: var(--green); text-decoration: underline; }

    .metric-cell {
      display: flex;
      min-width: 0;
      flex-direction: column;
      justify-content: center;
      align-items: start;
      gap: 8px;
      padding: 14px 17px;
      border-left: 1px solid var(--line);
    }

    .mobile-label {
      display: none;
      color: var(--muted);
      font-size: 9px;
      font-weight: 750;
      letter-spacing: .08em;
    }

    .metric-number {
      font: 600 clamp(19px, 1.7vw, 28px)/1 var(--serif);
      letter-spacing: -.045em;
    }

    .metric-note { color: var(--muted); font-size: 8px; }

    .change {
      font: 750 10px/1 var(--mono);
      white-space: nowrap;
    }

    .change.positive { color: var(--orange); }
    .change.negative { color: var(--green); }
    .change.neutral { color: var(--muted); }

    .score-ring {
      --score: 0;
      display: grid;
      place-items: center;
      width: 57px;
      height: 57px;
      border-radius: 50%;
      background:
        radial-gradient(circle, var(--paper-light) 57%, transparent 59%),
        conic-gradient(var(--accent) calc(var(--score) * 3.6deg), #dfe1db 0);
    }

    .score-ring strong { font: 700 18px/1 var(--serif); }
    .score-ring.unavailable {
      color: var(--muted);
      background: #e0e2dc;
    }
    .score-ring.unavailable strong { font: 700 9px/1 var(--mono); }

    .empty-state {
      display: grid;
      place-content: center;
      min-height: 230px;
      text-align: center;
      border-bottom: 1px solid var(--line);
      background: rgba(250,249,244,.72);
    }

    .empty-state strong { font: 600 27px/1 var(--serif); }
    .empty-state span { margin-top: 9px; color: var(--muted); font-size: 11px; }

    .pagination {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 20px;
      align-items: center;
      margin-top: 23px;
    }

    .pagination > button {
      width: 104px;
    }

    .pagination > button:first-child { justify-self: start; }
    .pagination > button:last-child { justify-self: end; }
    .page-numbers { display: flex; gap: 5px; }

    .pagination button {
      min-width: 37px;
      height: 37px;
      padding: 0 11px;
      border: 1px solid var(--line);
      background: var(--paper-light);
      color: var(--muted);
      font-size: 10px;
      font-weight: 700;
    }

    .pagination button:hover:not(:disabled),
    .pagination button[aria-current="page"] {
      border-color: var(--ink);
      color: var(--yellow);
      background: var(--ink);
    }

    .pagination button:disabled { cursor: not-allowed; opacity: .35; }

    .methodology {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(260px, .7fr);
      gap: 50px;
      margin-top: 67px;
      padding: 32px;
      border: 1px solid var(--ink);
      background: var(--yellow);
    }

    .methodology small {
      display: block;
      margin-bottom: 13px;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .15em;
    }

    .methodology strong {
      display: block;
      font: 600 28px/1.1 var(--serif);
    }

    .methodology p {
      margin: 0;
      color: rgba(24,32,29,.72);
      font-size: 12px;
      line-height: 1.8;
    }

    footer {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 30px;
      align-items: end;
      padding: 52px 0;
      border-top: 1px solid var(--line);
    }

    .footer-mark {
      --dot-travel: 22px;
      width: min(360px, 80vw);
      overflow: visible;
    }

    .footer-copy {
      max-width: 310px;
      color: var(--muted);
      text-align: right;
      font-size: 11px;
      line-height: 1.8;
    }

    .footer-copy a {
      display: inline-block;
      margin-top: 8px;
      border-bottom: 1px solid currentColor;
      color: var(--ink);
      font-weight: 700;
      letter-spacing: .08em;
    }

    @keyframes dotOrbitClockwise {
      0%, 100% { transform: translate(0, 0) scale(1); }
      25% { transform: translate(var(--dot-travel), calc(var(--dot-travel) * -.65)) scale(.86); }
      50% { transform: translate(0, calc(var(--dot-travel) * -1.1)) scale(1.08); }
      75% { transform: translate(calc(var(--dot-travel) * -1), calc(var(--dot-travel) * -.65)) scale(.9); }
    }

    @keyframes dotOrbitCounter {
      0%, 100% { transform: translate(0, 0) scale(1); }
      25% { transform: translate(calc(var(--dot-travel) * -1), calc(var(--dot-travel) * .65)) scale(.88); }
      50% { transform: translate(0, var(--dot-travel)) scale(1.08); }
      75% { transform: translate(var(--dot-travel), calc(var(--dot-travel) * .65)) scale(.9); }
    }

    @media (max-width: 1100px) {
      .hero { grid-template-columns: 1fr; min-height: 0; }
      .pulse-card { width: min(100%, 660px); }
      .summary-strip { grid-template-columns: repeat(3, 1fr); }
      .summary-label { grid-column: 1 / -1; }
      .toolbar { grid-template-columns: 1fr; }
      .filter-control { flex-wrap: wrap; }
      .rank-table { overflow-x: auto; }
      .rank-head, .company-row { min-width: 980px; }
    }

    @media (max-width: 760px) {
      .shell { width: min(100% - 28px, 560px); }
      .site-header { height: 76px; }
      .wordmark { width: 105px; }
      .brand-label { display: none; }
      .header-nav { gap: 15px; font-size: 11px; }
      .header-nav a:not([aria-current="page"]) { display: none; }
      .hero { gap: 36px; padding: 34px 0 48px; }
      h1 { font-size: clamp(52px, 16vw, 75px); }
      .hero-intro { font-size: 13px; }
      .pulse-card { padding: 23px 18px 0; box-shadow: 9px 9px 0 var(--yellow); }
      .pulse-head strong { font-size: 38px; }
      .leader-stairs { min-height: 220px; }
      .leader-step { padding: 13px 10px 12px; }
      .leader-icon { width: 32px; height: 32px; }
      .leader-company b { font-size: 9px; }
      .leader-traffic small { display: none; }
      .summary-strip { grid-template-columns: 1fr 1fr; }
      .summary-label { grid-column: 1 / -1; }
      .summary-strip > * { min-height: 116px; padding: 19px; }
      .ranking-section { padding: 70px 0 80px; }
      .section-head { align-items: start; flex-direction: column; }
      .search-control input { font-size: 16px; }
      .filter-control {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }
      .filter-control button { border: 1px solid var(--line); }
      .rank-table { overflow: visible; }
      .rank-head { display: none; }
      .company-row {
        min-width: 0;
        grid-template-columns: 1fr 1fr;
        margin-bottom: 13px;
        border: 1px solid var(--ink);
        background: var(--paper-light);
      }
      .company-cell {
        grid-column: 1 / -1;
        padding: 17px 15px;
        border-bottom: 1px solid var(--ink);
      }
      .metric-cell {
        min-height: 100px;
        padding: 15px;
        border-left: 0;
        border-bottom: 1px solid var(--line);
      }
      .metric-cell:nth-child(even) { border-right: 1px solid var(--line); }
      .metric-cell:last-child { grid-column: 1 / -1; border-bottom: 0; }
      .mobile-label { display: block; }
      .metric-number { font-size: 25px; }
      .score-ring { width: 52px; height: 52px; }
      .company-row:hover { box-shadow: none; transform: none; }
      .pagination {
        grid-template-columns: 1fr 1fr;
      }
      .page-numbers {
        grid-column: 1 / -1;
        grid-row: 1;
        justify-content: center;
      }
      .pagination > button { grid-row: 2; }
      .methodology { grid-template-columns: 1fr; gap: 19px; padding: 25px; }
      footer { grid-template-columns: 1fr; }
      .footer-copy { text-align: left; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>
<body class="reference-page">
  <div class="noise" aria-hidden="true"></div>

  <div style="max-width:1080px;margin:0 auto;padding:0 20px;">
    <SiteHeader active="seo" showTheme={false} />
  </div>

  <main>
    <section class="hero shell">
      <div>
        <p class="eyebrow">YUEQING SEARCH INTELLIGENCE / 乐清搜索情报</p>
        <h1>乐清 SEO 榜单</h1>
        <p class="hero-intro">
          聚焦乐清电气企业的<strong>自然流量、关键词、链接资产与 AI 品牌曝光</strong>。
          以域名为观察对象，用统一快照比较相对位置和增长信号。
        </p>
      </div>

      <aside class="pulse-card" aria-label="自然流量领先站点">
        <div class="pulse-head">
          <span>TRAFFIC TOP 3 / 自然流量前三</span>
          <div class="pulse-total">
            <strong>{formatNumber(summary.traffic)}</strong>
            <small>监测站点总流量</small>
          </div>
        </div>
        <div class="leader-stairs">
          {leaders.map((company, index) => (
            <article
              class="leader-step"
              style={`--step-height:${245 - index * 40}px;--step-color:${index === 0 ? "var(--yellow)" : index === 1 ? "var(--paper-light)" : "var(--orange)"}`}
            >
              <div class="leader-rank">
                <strong>{String(index + 1).padStart(2, "0")}</strong>
                <img class="leader-icon" src={company.icon} alt="" width="38" height="38">
              </div>
              <div class="leader-company">
                <b>{company.brand}</b>
                <small>{company.domain}</small>
              </div>
              <div class="leader-traffic">
                <span>{formatNumber(company.traffic)}</span>
                <small>TRAFFIC</small>
              </div>
            </article>
          ))}
        </div>
      </aside>
    </section>

    <section class="summary-strip shell" aria-label="SEO 数据概览">
      <div class="summary-label">
        <small>SNAPSHOT / 数据快照</small>
        <strong>2026.08.29</strong>
      </div>
      <div class="summary-card"><span>监测站点</span><strong>{summary.sites}</strong></div>
      <div class="summary-card"><span>自然流量</span><strong>{formatNumber(summary.traffic)}</strong></div>
      <div class="summary-card"><span>自然关键词</span><strong>{formatNumber(summary.keywords)}</strong></div>
      <div class="summary-card"><span>AI 提及</span><strong>{formatNumber(summary.mentions)}</strong></div>
      <div class="summary-card"><span>反向链接</span><strong>{formatNumber(summary.backlinks)}</strong></div>
    </section>

    <section class="ranking-section shell">
      <div class="section-head">
        <div>
          <p class="section-kicker">COMPETITIVE SIGNALS / 竞争信号</p>
          <h2>企业搜索表现排名</h2>
        </div>
        <p class="result-count">当前匹配 <strong id="seoResultCount">{companies.length}</strong> 个站点</p>
      </div>

      <div class="toolbar">
        <label class="search-control">
          <span aria-hidden="true">⌕</span>
          <input id="seoSearch" type="search" placeholder="搜索品牌、企业名称或域名" autocomplete="off">
        </label>

        <div class="filter-control" id="seoFilter" aria-label="筛选站点">
          <button type="button" data-filter="all" aria-pressed="true">全部</button>
          <button type="button" data-filter="growing" aria-pressed="false">流量增长</button>
          <button type="button" data-filter="declining" aria-pressed="false">流量下降</button>
          <button type="button" data-filter="ai" aria-pressed="false">有 AI 提及</button>
        </div>

        <label class="sort-control">
          <select id="seoSort" aria-label="选择排序指标">
            <option value="traffic">按自然流量排序</option>
            <option value="keywords">按自然关键词排序</option>
            <option value="backlinks">按反向链接排序</option>
            <option value="aiVisibility">按 AI 可见度排序</option>
            <option value="mentions">按 AI 提及排序</option>
          </select>
        </label>
      </div>

      <div class="rank-table">
        <div class="rank-head" aria-hidden="true">
          <span>排名 / 公司</span>
          <span>AI 可见度</span>
          <span>AI 提及</span>
          <span>自然流量</span>
          <span>自然关键词</span>
          <span>反向链接</span>
        </div>

        <div id="seoRows" aria-live="polite">
          {initialCompanies.map((company, index) => (
            <article class="company-row" style={`--accent:${company.accent}`}>
              <div class="company-cell">
                <span class="rank-number">{String(index + 1).padStart(2, "0")}</span>
                <span class="company-avatar">
                  <span>{company.initials}</span>
                  <img src={company.icon} alt="" loading="lazy">
                </span>
                <span class="company-name">
                  <strong>{company.brand}</strong>
                  <a href={`https://${company.domain}`} target="_blank" rel="nofollow noopener noreferrer">{company.domain}</a>
                </span>
              </div>
              <div class="metric-cell">
                <span class="mobile-label">AI 可见度</span>
                <div class:list={["score-ring", { unavailable: company.aiVisibility === null }]} style={`--score:${company.aiVisibility ?? 0};--accent:${company.accent}`}>
                  <strong>{company.aiVisibility ?? "N/A"}</strong>
                </div>
              </div>
              <div class="metric-cell">
                <span class="mobile-label">AI 提及</span>
                <strong class="metric-number">{formatNumber(company.mentions)}</strong>
                <span class="metric-note">{company.mentions ? "已被 AI 提及" : "尚无提及"}</span>
              </div>
              {[
                ["自然流量", company.traffic, company.trafficChange],
                ["自然关键词", company.keywords, company.keywordsChange],
                ["反向链接", company.backlinks, company.backlinksChange],
              ].map(([label, value, change]) => (
                <div class="metric-cell">
                  <span class="mobile-label">{label}</span>
                  <strong class="metric-number">{formatNumber(value as number | null)}</strong>
                  <span class={`change ${changeClass(change as number | null)}`}>{changeText(change as number | null)}</span>
                </div>
              ))}
            </article>
          ))}
        </div>
      </div>

      <nav class="pagination" aria-label="SEO 榜单分页">
        <button id="seoPrev" type="button" disabled>← 上一页</button>
        <div class="page-numbers" id="seoPages"></div>
        <button id="seoNext" type="button">下一页 →</button>
      </nav>

      <aside class="methodology">
        <div>
          <small>ABOUT THE DATA / 数据说明</small>
          <strong>比较趋势，不虚构精确结论</strong>
        </div>
        <p>
          数据来源为 Semrush，属于第三方估算数据，不代表企业真实流量，也不构成精准结论。
          精确数据需由企业自行登录 Google Search Console（GSC）查询；当前快照日期为 {snapshotDate}。
        </p>
      </aside>
    </section>
  </main>

  <footer class="shell">
    <Wordmark class="footer-mark" />
    <div class="footer-copy">
      <strong>OXOX.CN · 乐清 SEO 榜单</strong><br>
      企业搜索表现、AI 品牌曝光与增长信号。<br>
      <a href="https://si.gs/" target="_blank" rel="noopener noreferrer">Design by SIGS</a>
    </div>
  </footer>

  <script>
    import seoCompanies from "../../data/seo-companies.js";
    import {
      filterSeoCompanies,
      paginateSeoCompanies,
    } from "../../lib/seo-ranking-core.js";

    const palette = ["#ff5c35", "#f5d451", "#0b634b", "#5f94c9", "#c8789b", "#8588c7"];
    const companies = seoCompanies.map((company, index) => ({
      ...company,
      accent: palette[index % palette.length],
      icon: `/company-icons/${company.domain}.png`,
      initials: company.brand.replace(/[^A-Z0-9]/g, "").slice(0, 2) || "YQ",
    }));
    const search = document.querySelector<HTMLInputElement>("#seoSearch");
    const filter = document.querySelector<HTMLElement>("#seoFilter");
    const sort = document.querySelector<HTMLSelectElement>("#seoSort");
    const rows = document.querySelector<HTMLElement>("#seoRows");
    const count = document.querySelector<HTMLElement>("#seoResultCount");
    const pages = document.querySelector<HTMLElement>("#seoPages");
    const previous = document.querySelector<HTMLButtonElement>("#seoPrev");
    const next = document.querySelector<HTMLButtonElement>("#seoNext");
    if (!search || !filter || !sort || !rows || !count || !pages || !previous || !next) {
      throw new Error("SEO ranking controls are missing");
    }

    const pageSize = 20;
    let activeFilter = "all";
    let activePage = 1;

    const formatNumber = (value: number | null) => {
      if (value === null) return "N/A";
      if (value >= 100000) return `${(value / 10000).toFixed(value % 10000 === 0 ? 0 : 1)}万`;
      if (value >= 10000) return `${(value / 10000).toFixed(1)}万`;
      return new Intl.NumberFormat("zh-CN").format(value);
    };

    const formatChange = (value: number | null) => {
      if (value === null) return { className: "neutral", text: "—" };
      const className = value === 0 ? "neutral" : value > 0 ? "positive" : "negative";
      const arrow = value === 0 ? "→" : value > 0 ? "↗" : "↘";
      return {
        className,
        text: `${arrow} ${value > 0 ? "+" : ""}${value.toFixed(value % 1 === 0 ? 0 : 2)}%`,
      };
    };

    const createMetric = (label: string, value: number | null, change: number | null) => {
      const cell = document.createElement("div");
      cell.className = "metric-cell";
      const mobileLabel = document.createElement("span");
      mobileLabel.className = "mobile-label";
      mobileLabel.textContent = label;
      const number = document.createElement("strong");
      number.className = "metric-number";
      number.textContent = formatNumber(value);
      const trend = document.createElement("span");
      const formatted = formatChange(change);
      trend.className = `change ${formatted.className}`;
      trend.textContent = formatted.text;
      cell.append(mobileLabel, number, trend);
      return cell;
    };

    const createRow = (company: typeof companies[number], rank: number) => {
      const row = document.createElement("article");
      row.className = "company-row";
      row.style.setProperty("--accent", company.accent);

      const companyCell = document.createElement("div");
      companyCell.className = "company-cell";
      const rankNumber = document.createElement("span");
      rankNumber.className = "rank-number";
      rankNumber.textContent = String(rank).padStart(2, "0");
      const avatar = document.createElement("span");
      avatar.className = "company-avatar";
      const initials = document.createElement("span");
      initials.textContent = company.initials;
      const icon = document.createElement("img");
      icon.src = `/company-icons/${company.domain}.png`;
      icon.alt = "";
      icon.loading = "lazy";
      avatar.append(initials, icon);
      const companyName = document.createElement("span");
      companyName.className = "company-name";
      const brand = document.createElement("strong");
      brand.textContent = company.brand;
      const domain = document.createElement("a");
      domain.href = `https://${company.domain}`;
      domain.target = "_blank";
      domain.rel = "nofollow noopener noreferrer";
      domain.textContent = company.domain;
      companyName.append(brand, domain);
      companyCell.append(rankNumber, avatar, companyName);

      const scoreCell = document.createElement("div");
      scoreCell.className = "metric-cell";
      const scoreLabel = document.createElement("span");
      scoreLabel.className = "mobile-label";
      scoreLabel.textContent = "AI 可见度";
      const score = document.createElement("div");
      score.className = `score-ring${company.aiVisibility === null ? " unavailable" : ""}`;
      score.style.setProperty("--score", String(company.aiVisibility ?? 0));
      score.style.setProperty("--accent", company.accent);
      const scoreValue = document.createElement("strong");
      scoreValue.textContent = String(company.aiVisibility ?? "N/A");
      score.append(scoreValue);
      scoreCell.append(scoreLabel, score);

      const mentionCell = document.createElement("div");
      mentionCell.className = "metric-cell";
      const mentionLabel = document.createElement("span");
      mentionLabel.className = "mobile-label";
      mentionLabel.textContent = "AI 提及";
      const mentionNumber = document.createElement("strong");
      mentionNumber.className = "metric-number";
      mentionNumber.textContent = formatNumber(company.mentions);
      const mentionNote = document.createElement("span");
      mentionNote.className = "metric-note";
      mentionNote.textContent = company.mentions ? "已被 AI 提及" : "尚无提及";
      mentionCell.append(mentionLabel, mentionNumber, mentionNote);

      row.append(
        companyCell,
        scoreCell,
        mentionCell,
        createMetric("自然流量", company.traffic, company.trafficChange),
        createMetric("自然关键词", company.keywords, company.keywordsChange),
        createMetric("反向链接", company.backlinks, company.backlinksChange),
      );
      return row;
    };

    const render = () => {
      const filtered = filterSeoCompanies(companies, {
        query: search.value,
        filter: activeFilter,
        sortBy: sort.value,
      });
      const page = paginateSeoCompanies(filtered, activePage, pageSize);
      activePage = page.page;
      count.textContent = String(page.total);
      rows.replaceChildren();

      if (!page.items.length) {
        const empty = document.createElement("div");
        empty.className = "empty-state";
        const title = document.createElement("strong");
        title.textContent = "没有匹配的站点";
        const message = document.createElement("span");
        message.textContent = "请尝试更换关键词或筛选条件。";
        empty.append(title, message);
        rows.append(empty);
      } else {
        const fragment = document.createDocumentFragment();
        page.items.forEach((company: typeof companies[number], index: number) => {
          fragment.append(createRow(company, (page.page - 1) * pageSize + index + 1));
        });
        rows.append(fragment);
      }

      pages.replaceChildren();
      for (let pageNumber = 1; pageNumber <= page.pageCount; pageNumber += 1) {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = String(pageNumber);
        button.setAttribute("aria-label", `第 ${pageNumber} 页`);
        if (pageNumber === page.page) button.setAttribute("aria-current", "page");
        button.addEventListener("click", () => {
          activePage = pageNumber;
          render();
          document.querySelector(".ranking-section")?.scrollIntoView({ behavior: "smooth" });
        });
        pages.append(button);
      }
      previous.disabled = page.page === 1;
      next.disabled = page.page === page.pageCount;
    };

    search.addEventListener("input", () => {
      activePage = 1;
      render();
    });
    filter.addEventListener("click", (event) => {
      if (!(event.target instanceof HTMLButtonElement)) return;
      activeFilter = event.target.dataset.filter || "all";
      activePage = 1;
      filter.querySelectorAll("button").forEach((button) => {
        button.setAttribute("aria-pressed", String(button === event.target));
      });
      render();
    });
    sort.addEventListener("change", () => {
      activePage = 1;
      render();
    });
    previous.addEventListener("click", () => {
      activePage -= 1;
      render();
    });
    next.addEventListener("click", () => {
      activePage += 1;
      render();
    });
    render();
  </script>
</body>
</html>
