---
import "../styles/reference.css";
import "../styles/reference-pages.css";
import type { CollectionEntry } from "astro:content";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  entry: CollectionEntry<"articles">;
  related: CollectionEntry<"articles">[];
}

const { entry, related } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const issue = entry.data.periodEnd.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit" }).replace("/", " · ");
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  mainEntityOfPage: canonical.href,
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首页", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "数据解读", item: new URL("/articles/", Astro.site).href },
    { "@type": "ListItem", position: 3, name: entry.data.title, item: canonical.href },
  ],
};
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={entry.data.description}>
  <meta name="theme-color" content="#f2f0e8">
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title>{entry.data.title}｜乐清外贸月报｜OXOX</title>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <style is:global>
    :root {
      --paper: #f2f0e8;
      --paper-light: #faf9f4;
      --ink: #18201d;
      --muted: #68716c;
      --green: #0b634b;
      --green-dark: #064636;
      --orange: #ff5c35;
      --yellow: #f5d451;
      --line: rgba(24, 32, 29, .16);
      --serif: "Iowan Old Style", "Baskerville", "Songti SC", "STSong", serif;
      --sans: "Avenir Next", "PingFang SC", "Hiragino Sans GB", sans-serif;
    }

    * { box-sizing: border-box; }
    html { background: var(--paper); scroll-behavior: smooth; }
    body {
      margin: 0;
      min-width: 320px;
      color: var(--ink);
      font-family: var(--sans);
      background:
        linear-gradient(90deg, transparent 49.9%, rgba(24,32,29,.035) 50%, transparent 50.1%),
        radial-gradient(circle at 10% 0%, rgba(255,255,255,.96), transparent 32rem),
        var(--paper);
      background-size: 56px 100%, auto, auto;
    }
    a { color: inherit; text-decoration: none; }
    svg { display: block; }
    .shell { width: min(1240px, calc(100% - 48px)); margin: 0 auto; }
    .noise {
      position: fixed;
      inset: 0;
      z-index: 20;
      opacity: .03;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E");
    }
    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 92px;
      border-bottom: 1px solid var(--line);
    }
    .brand { display: inline-flex; align-items: center; gap: 14px; }
    .wordmark { --dot-travel: 10px; width: 126px; overflow: visible; }
    .wordmark .logo-dot {
      transform-box: fill-box;
      transform-origin: center;
      will-change: transform;
    }
    .brand:hover .dot-warm, .brand:focus-visible .dot-warm { animation: dotOrbitClockwise .9s cubic-bezier(.45,0,.2,1); }
    .brand:hover .dot-green, .brand:focus-visible .dot-green { animation: dotOrbitCounter .9s .06s cubic-bezier(.45,0,.2,1); }
    .brand-label {
      padding-left: 14px;
      border-left: 1px solid var(--line);
      color: var(--muted);
      font-size: 12px;
      font-weight: 650;
      letter-spacing: .12em;
    }
    .header-nav { display: flex; align-items: center; gap: 28px; font-size: 12px; font-weight: 700; }
    .header-nav a { position: relative; }
    .header-nav a::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: -7px;
      left: 0;
      height: 2px;
      background: var(--orange);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform .2s ease;
    }
    .header-nav a:hover::after, .header-nav a:focus-visible::after { transform: scaleX(1); transform-origin: left; }
    .nav-cta { padding: 10px 15px; border: 1px solid var(--ink); border-radius: 999px; background: var(--yellow); }
    .nav-cta::after { display: none; }

    .report-cover {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(310px, .75fr);
      min-height: 590px;
      margin-top: 34px;
      border: 1px solid var(--ink);
      background: var(--ink);
      color: white;
      box-shadow: 14px 14px 0 var(--green);
      animation: coverIn .75s ease both;
    }
    .cover-copy { display: flex; flex-direction: column; justify-content: space-between; padding: clamp(36px, 6vw, 76px); }
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 10px;
      color: rgba(255,255,255,.58);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .breadcrumb i { width: 22px; height: 1px; background: var(--orange); }
    .cover-title { max-width: 760px; margin: 48px 0; }
    .cover-kicker { display: flex; align-items: center; gap: 10px; margin: 0 0 20px; color: var(--yellow); font-size: 11px; font-weight: 800; letter-spacing: .17em; }
    .cover-kicker::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--orange); }
    h1 {
      margin: 0;
      font-family: var(--serif);
      font-size: clamp(52px, 6.7vw, 94px);
      font-weight: 400;
      letter-spacing: -.065em;
      line-height: .98;
    }
    .cover-summary { max-width: 640px; margin: 26px 0 0; color: rgba(255,255,255,.66); font-size: 14px; line-height: 1.85; }
    .cover-meta { display: flex; gap: 32px; color: rgba(255,255,255,.55); font-size: 10px; font-weight: 700; letter-spacing: .12em; }
    .cover-panel {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-width: 0;
      padding: 38px;
      overflow: hidden;
      background: var(--yellow);
      color: var(--ink);
    }
    .cover-panel::before, .cover-panel::after {
      content: "";
      position: absolute;
      border: 1px solid rgba(24,32,29,.26);
      border-radius: 50%;
    }
    .cover-panel::before { top: -45px; right: -65px; width: 230px; height: 230px; }
    .cover-panel::after { top: 12px; right: -8px; width: 104px; height: 104px; background: var(--orange); }
    .issue-label { position: relative; z-index: 1; font-size: 10px; font-weight: 850; letter-spacing: .18em; }
    .issue-number {
      position: relative;
      z-index: 1;
      align-self: end;
      writing-mode: vertical-rl;
      font-family: var(--serif);
      font-size: clamp(52px, 6vw, 82px);
      letter-spacing: -.04em;
      line-height: .86;
    }
    .issue-note { position: relative; z-index: 1; max-width: 190px; font-size: 11px; font-weight: 750; line-height: 1.6; }

    .metric-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      margin-top: 74px;
      border-top: 1px solid var(--ink);
      border-right: 1px solid var(--ink);
      background: var(--paper-light);
    }
    .metric {
      min-height: 164px;
      padding: 28px;
      border-bottom: 1px solid var(--ink);
      border-left: 1px solid var(--ink);
    }
    .metric small { display: block; color: var(--muted); font-size: 10px; font-weight: 750; letter-spacing: .08em; }
    .metric strong { display: block; margin-top: 30px; font-family: var(--serif); font-size: clamp(26px, 3vw, 39px); font-weight: 400; letter-spacing: -.04em; }
    .metric em { display: block; margin-top: 8px; font-size: 11px; font-style: normal; font-weight: 800; }
    .metric em.up { color: var(--orange); }
    .metric em.down { color: var(--green); }
    .metric em.neutral { color: var(--muted); }

    .article-shell { width: min(1080px, calc(100% - 48px)); margin: 0 auto; padding: 110px 0 130px; }
    .article-body { max-width: 780px; margin: 0 auto; }
    .article-body .report-jump-nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      margin-bottom: 86px;
      border-top: 1px solid var(--ink);
      border-right: 1px solid var(--ink);
      background: var(--paper-light);
    }
    .article-body .report-jump-nav a {
      position: relative;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 3px 16px;
      min-height: 116px;
      padding: 25px 28px;
      border-bottom: 1px solid var(--ink);
      border-left: 1px solid var(--ink);
      transition: color .22s ease, background .22s ease;
    }
    .article-body .report-jump-nav a::after {
      content: "↘";
      position: absolute;
      right: 24px;
      bottom: 22px;
      color: var(--orange);
      font-size: 18px;
      transition: transform .22s ease;
    }
    .article-body .report-jump-nav a:hover,
    .article-body .report-jump-nav a:focus-visible { color: white; background: var(--green); }
    .article-body .report-jump-nav a:hover::after,
    .article-body .report-jump-nav a:focus-visible::after { transform: translate(4px, 4px); }
    .article-body .report-jump-nav span {
      grid-row: 1 / 3;
      color: var(--orange);
      font-family: var(--serif);
      font-size: 30px;
      line-height: 1;
    }
    .article-body .report-jump-nav strong { font-family: var(--serif); font-size: 23px; font-weight: 400; }
    .article-body .report-jump-nav small { color: var(--muted); font-size: 10px; letter-spacing: .06em; }
    .article-body .report-jump-nav a:hover small,
    .article-body .report-jump-nav a:focus-visible small { color: rgba(255,255,255,.66); }
    .article-body .section-anchor { position: relative; top: -28px; scroll-margin-top: 28px; }
    .article-body > h2 {
      position: relative;
      margin: 108px 0 30px;
      padding-top: 26px;
      border-top: 1px solid var(--ink);
      font-family: var(--serif);
      font-size: clamp(34px, 4vw, 50px);
      font-weight: 400;
      letter-spacing: -.04em;
      line-height: 1.15;
    }
    .article-body > h2:first-child { margin-top: 0; }
    .article-body .report-jump-nav + .section-anchor + h2 { margin-top: 0; }
    .article-body > h2::after {
      content: "";
      position: absolute;
      top: -5px;
      left: 0;
      width: 54px;
      height: 9px;
      border-radius: 99px;
      background: var(--orange);
    }
    .article-body p { margin: 0 0 22px; color: #38413d; font-size: 16px; line-height: 2; text-align: justify; }
    .article-body p strong { color: var(--ink); font-weight: 800; }
    .article-body > h3 {
      margin: 62px 0 18px;
      font-family: var(--serif);
      font-size: 27px;
      font-weight: 400;
      letter-spacing: -.025em;
    }
    .article-body ol { margin: 24px 0 34px; padding-left: 1.5em; }
    .article-body li { margin: 10px 0; color: #38413d; font-size: 15px; line-height: 1.85; }
    .article-body .insight-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: min(1080px, calc(100vw - 48px));
      margin-left: calc((780px - min(1080px, calc(100vw - 48px))) / 2);
      border-top: 1px solid var(--ink);
      border-right: 1px solid var(--ink);
    }
    .article-body .insight-grid article {
      min-height: 250px;
      padding: 32px;
      border-bottom: 1px solid var(--ink);
      border-left: 1px solid var(--ink);
      background: var(--paper-light);
    }
    .article-body .insight-grid b { color: var(--orange); font-family: var(--serif); font-size: 28px; font-weight: 400; }
    .article-body .insight-grid h3 { margin: 44px 0 12px; font-family: var(--serif); font-size: 25px; font-weight: 400; }
    .article-body .insight-grid p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.8; text-align: left; }

    .article-body .data-table-wrap {
      width: min(1080px, calc(100vw - 48px));
      margin: 44px 0 58px calc((780px - min(1080px, calc(100vw - 48px))) / 2);
      overflow-x: auto;
      border: 1px solid var(--ink);
      background: var(--paper-light);
      box-shadow: 8px 8px 0 rgba(11,99,75,.15);
      scrollbar-color: var(--green) transparent;
    }
    .article-body .data-table-wrap:focus-visible { outline: 3px solid var(--orange); outline-offset: 4px; }
    .article-body table { width: 100%; min-width: 760px; border-collapse: collapse; font-size: 12px; }
    .article-body caption {
      padding: 24px 20px;
      border-bottom: 1px solid var(--ink);
      background: var(--yellow);
      font-family: var(--serif);
      font-size: 22px;
      text-align: left;
    }
    .article-body caption small {
      display: inline-block;
      margin-left: 12px;
      color: rgba(24,32,29,.62);
      font-family: var(--sans);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .08em;
      vertical-align: middle;
    }
    .article-body th {
      position: sticky;
      top: 0;
      z-index: 1;
      padding: 14px 16px;
      border-right: 1px solid rgba(255,255,255,.12);
      background: var(--ink);
      color: rgba(255,255,255,.72);
      text-align: right;
      white-space: nowrap;
      font-size: 10px;
      font-weight: 750;
      letter-spacing: .04em;
    }
    .article-body th:first-child, .article-body th:nth-child(2):not(:last-child) { text-align: left; }
    .article-body td { padding: 14px 16px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); text-align: right; white-space: nowrap; }
    .article-body td:first-child, .article-body td:nth-child(2):not(:last-child) { text-align: left; }
    .article-body tbody tr:last-child td { border-bottom: 0; }
    .article-body tbody tr:hover { background: rgba(245,212,81,.24); }
    .article-body .subrow td:first-child { padding-left: 36px; color: var(--muted); }
    .article-body .total-row { font-weight: 800; background: rgba(11,99,75,.08); }
    .article-body .highlight-row { font-weight: 800; background: rgba(245,212,81,.35); }
    .article-body .wide-table table { min-width: 1060px; }
    .article-body .trend { font-weight: 850; }
    .article-body .trend-up { color: var(--orange); }
    .article-body .trend-down { color: var(--green); }
    .article-body .data-note {
      position: relative;
      margin: 34px 0 18px;
      padding: 26px 28px 24px 68px;
      border: 1px solid var(--ink);
      background: var(--yellow);
      box-shadow: 7px 7px 0 rgba(11,99,75,.16);
    }
    .article-body .data-note::before {
      content: "!";
      position: absolute;
      top: 26px;
      left: 25px;
      display: grid;
      width: 25px;
      height: 25px;
      place-items: center;
      border-radius: 50%;
      background: var(--orange);
      color: white;
      font-weight: 900;
    }
    .article-body .data-note b { font-family: var(--serif); font-size: 20px; font-weight: 400; }
    .article-body .data-note p { margin: 8px 0 0; color: #3d4033; font-size: 12px; line-height: 1.8; text-align: left; }

    .related { padding: 86px 0 110px; border-top: 1px solid var(--line); }
    .related-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 30px; }
    .related-head small { color: var(--orange); font-size: 10px; font-weight: 850; letter-spacing: .18em; }
    .related-head h2 { margin: 9px 0 0; font-family: var(--serif); font-size: 42px; font-weight: 400; letter-spacing: -.04em; }
    .related-grid { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--ink); border-right: 1px solid var(--ink); }
    .related-card { min-height: 230px; padding: 32px; border-bottom: 1px solid var(--ink); border-left: 1px solid var(--ink); background: var(--paper-light); transition: color .2s ease, background .2s ease; }
    .related-card:hover { color: white; background: var(--green); }
    .related-card small { font-size: 10px; font-weight: 800; letter-spacing: .12em; }
    .related-card h3 { max-width: 520px; margin: 56px 0 0; font-family: var(--serif); font-size: 28px; font-weight: 400; line-height: 1.25; }
    .site-footer { display: flex; justify-content: space-between; gap: 24px; padding: 30px 0 44px; border-top: 1px solid var(--line); color: var(--muted); font-size: 10px; letter-spacing: .1em; }

    @keyframes coverIn { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
    @keyframes dotOrbitClockwise {
      0%,100% { transform: translate(0) scale(1); }
      25% { transform: translate(var(--dot-travel), calc(var(--dot-travel) * -.55)) scale(.8); }
      50% { transform: translate(0, calc(var(--dot-travel) * -1)) scale(1.08); }
      75% { transform: translate(calc(var(--dot-travel) * -1), calc(var(--dot-travel) * -.45)) scale(.9); }
    }
    @keyframes dotOrbitCounter {
      0%,100% { transform: translate(0) scale(1); }
      25% { transform: translate(calc(var(--dot-travel) * -1), calc(var(--dot-travel) * .55)) scale(.8); }
      50% { transform: translate(0, var(--dot-travel)) scale(1.08); }
      75% { transform: translate(var(--dot-travel), calc(var(--dot-travel) * .45)) scale(.9); }
    }

    @media (max-width: 900px) {
      .header-nav { gap: 18px; }
      .report-cover { grid-template-columns: 1fr; min-height: auto; }
      .cover-panel { min-height: 240px; }
      .issue-number { writing-mode: horizontal-tb; align-self: start; }
      .metric-grid { grid-template-columns: 1fr 1fr; }
      .article-body .insight-grid, .article-body .data-table-wrap {
        width: calc(100vw - 48px);
        margin-left: calc((780px - (100vw - 48px)) / 2);
      }
    }
    @media (max-width: 640px) {
      .shell, .article-shell { width: min(100% - 30px, 1240px); }
      .site-header { height: 76px; }
      .wordmark { width: 101px; }
      .brand-label { display: none; }
      .header-nav a:not(.nav-cta) { display: none; }
      .report-cover { margin-top: 16px; box-shadow: 7px 7px 0 var(--green); }
      .cover-copy { padding: 28px 22px 34px; }
      .cover-title { margin: 42px 0; }
      h1 { font-size: clamp(43px, 13vw, 62px); }
      .cover-summary { font-size: 13px; }
      .cover-meta { flex-direction: column; gap: 8px; }
      .cover-panel { min-height: 205px; padding: 26px; }
      .issue-number { font-size: 50px; }
      .metric-grid { grid-template-columns: 1fr; margin-top: 48px; }
      .metric { min-height: 132px; }
      .metric strong { margin-top: 20px; }
      .article-shell { padding: 76px 0 90px; }
      .article-body > h2 { margin-top: 82px; font-size: 34px; }
      .article-body p { font-size: 15px; text-align: left; }
      .article-body .insight-grid, .article-body .data-table-wrap {
        width: calc(100vw - 30px);
        margin-left: 0;
      }
      .article-body .insight-grid { grid-template-columns: 1fr; }
      .article-body .report-jump-nav { grid-template-columns: 1fr; margin-bottom: 68px; }
      .article-body .report-jump-nav a { min-height: 102px; padding: 22px; }
      .article-body .insight-grid article { min-height: 210px; padding: 26px; }
      .article-body .insight-grid h3 { margin-top: 28px; }
      .article-body caption { font-size: 19px; }
      .article-body caption small { display: block; margin: 7px 0 0; }
      .article-body .data-note { padding: 62px 22px 22px; }
      .article-body .data-note::before { top: 22px; left: 22px; }
      .related { padding: 66px 0 80px; }
      .related-grid { grid-template-columns: 1fr; }
      .site-footer { flex-direction: column; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
    }
  </style>
</head>
<body class="reference-page">
  <div class="noise" aria-hidden="true"></div>
  <div style="max-width:1080px;margin:0 auto;padding:0 20px;">
    <SiteHeader active="articles" showTheme={false} />
  </div>

  <main>
    <section class="report-cover shell">
      <div class="cover-copy">
        <div class="breadcrumb"><a href="/articles/">数据解读</a><i aria-hidden="true"></i><span>{entry.data.categoryLabel}</span></div>
        <div class="cover-title">
          <p class="cover-kicker">YUEQING FOREIGN TRADE REPORT</p>
          <h1>{entry.data.title}</h1>
          <p class="cover-summary">{entry.data.description}</p>
        </div>
        <div class="cover-meta"><span>统计周期 / {entry.data.period}</span><span>发布日期 / {entry.data.publishedAt.toLocaleDateString("zh-CN")}</span></div>
      </div>
      <aside class="cover-panel" aria-label="月报期号">
        <span class="issue-label">MONTHLY REPORT / 月报</span>
        <strong class="issue-number">{issue}</strong>
        <span class="issue-note">数据简报 · 企业结构 · 产品与市场</span>
      </aside>
    </section>

    <section class="metric-grid shell" aria-label="核心指标">
      {entry.data.stats.map((stat: { label: string; value: string; change: string; tone: "up" | "down" | "neutral" }) => (
        <article class="metric">
          <small>{stat.label}</small>
          <strong>{stat.value}</strong>
          <em class={stat.tone}>{stat.change}</em>
        </article>
      ))}
    </section>

    <article class="article-shell">
      <div class="article-body"><slot /></div>
    </article>

    {related.length > 0 && (
      <section class="related">
        <div class="shell">
          <div class="related-head">
            <div><small>CONTINUE READING / 继续阅读</small><h2>更多乐清外贸月报</h2></div>
